digraph CallGraph {
  rankdir=LR;
  splines=ortho;
  dpi=150; // Augmente la résolution (défaut=96). 150 est un bon début.
  size="20,20"; // Taille maximale en pouces (facultatif, mais aide à contrôler la taille)
  ratio=auto; // Ajuste les proportions
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  graph [label="xns.x3rsi", fontsize=12, fontcolor="blue"];

  subgraph cluster_0 {
    label = "AgentSyncService";
    style = "filled";
    color = "lightgrey";

    n0 [label="syncAgentsFromWazuh(...)"];
  }

  subgraph cluster_1 {
    label = "ScaCheckViewModel";
    style = "filled";
    color = "lightgrey";

    n1 [label="getRuleNumber(...)"];
    n2 [label="getStatus(...)"];
    n3 [label="getStatusCssClass(...)"];
  }

  subgraph cluster_2 {
    label = "TestController";
    style = "filled";
    color = "lightgrey";

    n4 [label="sayHello(...)"];
  }

  subgraph cluster_3 {
    label = "WebConfig";
    style = "filled";
    color = "lightgrey";

    n5 [label="addResourceHandlers(...)"];
  }

  subgraph cluster_4 {
    label = "WazuhAuthResponse";
    style = "filled";
    color = "lightgrey";

    n6 [label="getData(...)"];
  }

  subgraph cluster_5 {
    label = "TimestampingService";
    style = "filled";
    color = "lightgrey";

    n7 [label="TimestampingService(...)"];
    n8 [label="createTimestampResponse(...)"];
  }

  subgraph cluster_6 {
    label = "UserService";
    style = "filled";
    color = "lightgrey";

    n9 [label="assignAgentToUser(...)"];
  }

  subgraph cluster_7 {
    label = "WazuhTokenManager";
    style = "filled";
    color = "lightgrey";

    n10 [label="getValidToken(...)"];
    n11 [label="parseExpiryFromToken(...)"];
    n12 [label="isTokenExpired(...)"];
    n13 [label="fetchNewToken(...)"];
  }

  subgraph cluster_8 {
    label = "OvalVulnerabilityFilter";
    style = "filled";
    color = "lightgrey";

    n14 [label="buildCacheFromDatabase(...)"];
    n15 [label="preProcessOvalFile(...)"];
    n16 [label="createOptimizedReader(...)"];
    n17 [label="ingestOvalData(...)"];
    n18 [label="initialize(...)"];
    n19 [label="saveToDatabase(...)"];
    n20 [label="processDefinitions(...)"];
  }

  subgraph cluster_9 {
    label = "UserController";
    style = "filled";
    color = "lightgrey";

    n21 [label="getUserByUsername(...)"];
  }

  subgraph cluster_10 {
    label = "WazuhAlertsService";
    style = "filled";
    color = "lightgrey";

    n22 [label="buildAgentToGroupMap(...)"];
    n23 [label="fetchAndPushNewAlerts(...)"];
  }

  subgraph cluster_11 {
    label = "ReportController";
    style = "filled";
    color = "lightgrey";

    n24 [label="generateReport(...)"];
  }

  subgraph cluster_12 {
    label = "DataInitializer";
    style = "filled";
    color = "lightgrey";

    n25 [label="run(...)"];
  }

  subgraph cluster_13 {
    label = "X3rsiApplication";
    style = "filled";
    color = "lightgrey";

    n26 [label="main(...)"];
  }

  subgraph cluster_14 {
    label = "ReportGenerationService";
    style = "filled";
    color = "lightgrey";

    n27 [label="toHexString(...)"];
    n28 [label="createZipArchive(...)"];
    n29 [label="generateReportZip(...)"];
  }

  subgraph cluster_15 {
    label = "OvalParsingConfiguration";
    style = "filled";
    color = "lightgrey";

    n30 [label="ovalTaskExecutor(...)"];
  }

  subgraph cluster_16 {
    label = "JwtAuthenticationFilter";
    style = "filled";
    color = "lightgrey";

    n31 [label="doFilterInternal(...)"];
  }

  subgraph cluster_17 {
    label = "WazuhTokenData";
    style = "filled";
    color = "lightgrey";

    n32 [label="getToken(...)"];
  }

  subgraph cluster_18 {
    label = "JwtService";
    style = "filled";
    color = "lightgrey";

    n33 [label="getSignInKey(...)"];
    n34 [label="extractUserId(...)"];
    n35 [label="extractExpiration(...)"];
    n36 [label="buildToken(...)"];
    n37 [label="isTokenExpired(...)"];
  }

  subgraph cluster_19 {
    label = "AuthService";
    style = "filled";
    color = "lightgrey";

    n38 [label="logout(...)"];
  }

  subgraph cluster_20 {
    label = "AuthController";
    style = "filled";
    color = "lightgrey";

    n39 [label="logout(...)"];
  }

  n15 -> n16 [color="black"];
  n10 -> n12 [color="black"];
  n10 -> n13 [color="black"];
  n36 -> n33 [color="black"];
  n37 -> n35 [color="black"];
  n17 -> n15 [color="black"];
  n17 -> n20 [color="black"];
  n17 -> n19 [color="black"];
  n18 -> n14 [color="black"];
  n18 -> n17 [color="black"];
  n20 -> n16 [color="black"];
  n29 -> n28 [color="black"];
  n29 -> n27 [color="black"];
  n23 -> n22 [color="black"];
  n13 -> n6 [color="black"];
  n13 -> n11 [color="black"];
  n13 -> n32 [color="black"];

  subgraph cluster_legend {
    rankdir = TB; // Orientation de haut en bas pour la légende
    label = "Légende";
    style = "dotted";
    bgcolor = "white";
    // Utilisation d'un label HTML pour un alignement parfait
    key [shape=none, margin=0, label=<
      <table border="0" cellpadding="2" cellspacing="0" cellborder="0">
        <tr><td align="right" port="c1">Appel de méthode</td><td>&nbsp;</td><td align="left" port="c2">&nbsp;</td></tr>
        <tr><td align="right" port="i1">Instanciation (new)</td><td>&nbsp;</td><td align="left" port="i2">&nbsp;</td></tr>
        <tr><td align="right" port="t1">Lève une exception</td><td>&nbsp;</td><td align="left" port="t2">&nbsp;</td></tr>
      </table>
    >];
    // On dessine les arêtes colorées en se connectant aux ports du tableau HTML
    key:c1 -> key:c2 [color="black"];
    key:i1 -> key:i2 [color="darkgreen"];
    key:t1 -> key:t2 [color="red"];
  }
}
